  "scripts": {
    "dev": "node scripts/runners/run-next.mjs dev -- --webpack -p 3000",
    "build": "node scripts/runners/run-next.mjs build",
    "start": "node scripts/runners/run-next.mjs start",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/runners/run-eslint.mjs",
    "lint:fix": "node scripts/runners/run-eslint.mjs --fix",
    "check:names": "node scripts/check-names.mjs",
    "check:clean-base": "tsx scripts/check-clean-base.ts",
    "check:domain-registries": "tsx scripts/check-domain-registries.ts",
    "check:architecture": "pnpm check:clean-base && pnpm check:domain-registries",
    "check:duplicates": "tsx scripts/check-duplicates.ts",
    "check:style-guidance": "tsx scripts/check-style-guidance.ts",
    "check:guidance": "pnpm check:duplicates && pnpm check:style-guidance",
    "check:minimal": "pnpm typecheck && pnpm lint && pnpm check:names",
    "check:baseline": "pnpm check:minimal && pnpm check:architecture",
    "check:all": "pnpm check:minimal && pnpm check:architecture && pnpm check:guidance && pnpm build",
    "check:frontend": "node scripts/check-frontend.mjs",
    "check:release": "pnpm check:all && pnpm check:frontend",
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke"
  }
