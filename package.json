  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.58.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.33",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "autoprefixer": "^10.4.27",
    "axe-core": "^4.11.1",
    "eslint": "^9.39.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.8",
    "postcss-import": "^16.1.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "ts-morph": "^27.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "generate:component-docs": "node scripts/generators/generate-component-docs.cjs",
    "generate:global-inventory": "node scripts/generators/generate-global-inventory.mjs",
    "generate:content-registries": "node scripts/generators/generate-content-registries.mjs",
    "generate:authority-scores": "tsx scripts/generators/generate-topic-authority-scores.ts",
    "generate:authority-map": "tsx scripts/generators/generate-authority-map.ts",
    "generate:core": "npm run -s generate:component-docs && npm run -s generate:content-registries && npm run -s generate:authority-map && npm run -s generate:authority-scores",
    "generate:dev": "npm run -s generate:global-inventory",
    "generate:all": "npm run -s generate:core && npm run -s generate:dev",
    "check:generated": "node --import tsx/esm scripts/core/check-generated.mjs",
    "system:report": "node --import tsx/esm scripts/analyzers/export-reports.mjs",
    "export:reports": "node --import tsx/esm scripts/analyzers/export-reports.mjs",
    "system:full": "node scripts/core/run-system-full.mjs",
    "system:quick": "node scripts/core/run-system-full.mjs --mode=summary --skip-tests",
    "system:debug": "node scripts/core/run-system-full.mjs --mode=debug --force",
    "system:clean": "node scripts/core/clean-system.mjs",
    "preaudit": "node scripts/core/preaudit.mjs",
    "predev": "npm run -s generate:all",
    "dev": "node scripts/runners/run-next.mjs dev -- --webpack -p 3000",
    "dev:audit": "node scripts/dev/audit-server.mjs start",
    "dev:audit:foreground": "node scripts/runners/run-next.mjs dev -- --webpack -p 3009",
    "dev:audit:stop": "node scripts/dev/audit-server.mjs stop",
    "dev:audit:status": "node scripts/dev/audit-server.mjs status",
    "dev:turbo": "node scripts/runners/run-next.mjs dev -- --turbopack -p 3008",
    "next:cache:clean": "rm -rf .next",
    "next:dev": "npm run -s next:cache:clean && npm run build && npm run dev",
    "next:dev:rescue": "pkill -f \"next-server \\(v16\\.1\\.6\\)\" || true; npm run -s next:cache:clean; npm run dev",
    "prebuild": "npm run -s generate:core && node scripts/core/validate-all.mjs",
    "build": "node scripts/runners/run-next.mjs build",
    "start": "node scripts/runners/run-next.mjs start -- -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/runners/run-eslint.mjs",
    "lint:fix": "node scripts/runners/run-eslint.mjs --fix",
    "format": "prettier --write src/**/*.{ts,tsx}",
    "validate": "npm run typecheck && npm run lint",
    "validate:docs": "npm run -s generate:global-inventory && node scripts/validators/validate-docs.mjs",
    "validate:content-contract": "tsx scripts/validators/validate-content-contract.mjs",
    "validate:content-quality": "tsx scripts/validators/validate-content-quality.mjs",
    "validate:domain-structure": "tsx scripts/validators/validate-domain-structure.mjs",
    "validate:cta-label-contract": "tsx scripts/validators/validate-cta-label-contract.mjs",
    "validate:conversion-contract": "tsx scripts/validators/validate-conversion-contract.mjs",
    "validate:template-payload-sufficiency": "tsx scripts/validators/validate-template-payload-sufficiency.mjs",
    "validate:section-structure": "tsx scripts/validators/validate-section-structure.mjs",
    "validate:case-study-structure": "tsx scripts/validators/validate-domain-structure.mjs --type case-study",
    "validate:case-study-structure:fix": "tsx scripts/validators/validate-domain-structure.mjs --type case-study --fix",
    "validate:case-study-structure:report": "tsx scripts/validators/validate-domain-structure.mjs --type case-study --report-json",
    "validate:service-structure": "tsx scripts/validators/validate-domain-structure.mjs --type service",
    "validate:service-structure:fix": "tsx scripts/validators/validate-domain-structure.mjs --type service --fix",
    "validate:service-structure:report": "tsx scripts/validators/validate-domain-structure.mjs --type service --report-json",
    "validate:feature-structure": "tsx scripts/validators/validate-domain-structure.mjs --type feature",
    "validate:feature-structure:fix": "tsx scripts/validators/validate-domain-structure.mjs --type feature --fix",
    "validate:feature-structure:report": "tsx scripts/validators/validate-domain-structure.mjs --type feature --report-json",
    "validate:home-structure": "tsx scripts/validators/validate-domain-structure.mjs --type home",
    "validate:home-structure:report": "tsx scripts/validators/validate-domain-structure.mjs --type home --report-json",
    "validate:industry-structure": "tsx scripts/validators/validate-domain-structure.mjs --type industry",
    "validate:industry-structure:fix": "tsx scripts/validators/validate-domain-structure.mjs --type industry --fix",
    "validate:industry-structure:report": "tsx scripts/validators/validate-domain-structure.mjs --type industry --report-json",
    "graph:validate": "tsx scripts/validators/validate-graph.ts",
    "graph:inspect": "NODE_ENV=development tsx scripts/analyzers/inspect-graph.ts",
    "validate:design": "node scripts/validators/validate-design-system.cjs",
    "validate:system-knowledge": "node --import tsx/esm scripts/validators/validate-system-knowledge.ts",
    "analyze:gaps": "tsx scripts/analyzers/generate-content-gaps.ts",
    "analyze:intelligence": "tsx scripts/analyzers/generate-content-intelligence.ts",
    "analyze:score": "tsx scripts/analyzers/score-content.mjs",
    "analyze:consistency": "tsx scripts/analyzers/audit-content-consistency.mjs",
    "analyze:priority": "tsx scripts/analyzers/detect-page-priorities.mjs",
    "phase7:visual": "node --import tsx/esm scripts/analyzers/run-visual-audit.js",
    "analyze": "node scripts/core/disallow-manual-report-paths.mjs system:full",
    "validate:all": "node scripts/core/validate-all.mjs",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:system": "vitest run tests/system",
    "test:runtime": "vitest run tests/unit tests/system tests/integration",
    "test:e2e": "playwright test",
    "test:all": "npm run -s system:full",
    "test:smoke": "playwright test tests/smoke",
    "test:seo": "playwright test tests/seo",
    "test:interactions": "playwright test tests/interactions",
    "test:visual": "playwright test tests/visual",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "validate:ci": "npm run -s validate:all && npm run -s build && npm run -s test:all",
    "images:test": "tsx scripts/image-system/image-generate.ts --mode test",
    "images:blog": "tsx scripts/image-system/image-generate.ts --domain blog",
    "images:resources": "tsx scripts/image-system/image-generate.ts --domain resources",
    "images:industries": "tsx scripts/image-system/image-generate.ts --domain industries",
    "images:case-studies": "tsx scripts/image-system/image-generate.ts --domain case-studies",
    "image:generate": "tsx scripts/image-system/image-generate.ts",
    "images:queue:start": "tsx scripts/image-system/image-generate.ts --queue start",
    "images:queue:status": "tsx scripts/image-system/image-generate.ts --queue status",
    "images:queue:resume": "tsx scripts/image-system/image-generate.ts --queue resume",
    "images:inspect": "tsx scripts/image-system/image-inspect.ts",
    "images:diagram": "tsx scripts/image-system/image-generate.ts --diagram"
  }
}