            "@radix-ui/react-menubar": "^1.1.6",
            "@radix-ui/react-navigation-menu": "^1.2.5",
            "@radix-ui/react-popover": "^1.1.6",
            "@radix-ui/react-progress": "^1.1.2",
            "@radix-ui/react-radio-group": "^1.2.3",
            "@radix-ui/react-scroll-area": "^1.2.3",
            "@radix-ui/react-select": "^2.1.6",
            "@radix-ui/react-separator": "^1.1.2",
            "@radix-ui/react-slider": "^1.2.3",
            "@radix-ui/react-slot": "^1.1.2",
            "@radix-ui/react-switch": "^1.1.3",
            "@radix-ui/react-tabs": "^1.1.3",
            "@radix-ui/react-toggle": "^1.1.2",
            "@radix-ui/react-toggle-group": "^1.1.2",
            "@radix-ui/react-tooltip": "^1.1.8",
            "class-variance-authority": "^0.7.1",
            "clsx": "^2.1.1",
            "lucide-react": "^0.576.0",
            "next": "^16.1.6",
            "react": "^19.2.4",
            "react-dom": "^19.2.4",
            "recharts": "^3.7.0",
            "sharp": "^0.34.5",
            "tailwind-merge": "^3.4.0"
      },
      "devDependencies": {
            "@eslint/js": "^9.39.3",
            "@next/bundle-analyzer": "^16.1.6",
            "@playwright/test": "^1.58.1",
            "@tailwindcss/postcss": "^4.2.1",
            "@testing-library/jest-dom": "^6.9.1",
            "@testing-library/react": "^16.3.2",
            "@types/node": "^20.19.33",
            "@types/react": "^19.2.14",
            "@types/react-dom": "^19.2.3",
            "@typescript-eslint/eslint-plugin": "^8.54.0",
            "@typescript-eslint/parser": "^8.54.0",
            "autoprefixer": "^10.4.27",
            "axe-core": "^4.11.1",
            "eslint": "^9.39.3",
            "eslint-plugin-jsx-a11y": "^6.10.2",
            "eslint-plugin-prettier": "^5.5.5",
            "eslint-plugin-react-hooks": "^7.0.1",
            "eslint-plugin-react-refresh": "^0.5.0",
            "eslint-plugin-simple-import-sort": "^12.1.1",
            "jsdom": "^28.1.0",
            "postcss": "^8.5.8",
            "postcss-import": "^16.1.1",
            "prettier": "^3.8.1",
            "tailwindcss": "^4.1.18",
            "ts-morph": "^27.0.2",
            "tsx": "^4.21.0",
            "typescript": "^5.9.3",
            "vitest": "^4.0.18"
      },
      "scripts": {
            "generate:component-docs": "node scripts/generators/generate-component-docs.cjs",
            "generate:global-inventory": "node scripts/generators/generate-global-inventory.mjs",
            "generate:content-registries": "node scripts/generators/generate-content-registries.mjs",
            "generate:authority-scores": "tsx scripts/generators/generate-topic-authority-scores.ts",
            "generate:authority-map": "tsx scripts/generators/generate-authority-map.ts",
            "generate:core": "npm run -s generate:content-registries && npm run -s generate:authority-map && npm run -s generate:authority-scores",
            "generate:dev": "npm run -s generate:component-docs && npm run -s generate:global-inventory",
            "check:generated": "node scripts/core/check-generated.mjs",
            "system:sync": "node scripts/core/system-sync.mjs",
            "predev": "npm run -s generate:core && npm run -s generate:dev",
            "dev": "node scripts/runners/run-next.mjs dev -- --webpack -p 3000",
            "dev:audit": "node scripts/dev/audit-server.mjs start",
            "dev:audit:foreground": "node scripts/runners/run-next.mjs dev -- --webpack -p 3009",
            "dev:audit:stop": "node scripts/dev/audit-server.mjs stop",
            "dev:audit:status": "node scripts/dev/audit-server.mjs status",
            "dev:turbo": "node scripts/runners/run-next.mjs dev -- --turbopack -p 3008",
            "next:cache:clean": "rm -rf .next",
            "next:dev": "npm run -s next:cache:clean && npm run build && npm run dev",
            "next:dev:rescue": "pkill -f \"next-server \\(v16\\.1\\.6\\)\" || true; npm run -s next:cache:clean; npm run dev",
            "prebuild": "npm run -s generate:core && node scripts/core/validate-all.mjs",
            "build": "node scripts/runners/run-next.mjs build",
            "start": "node scripts/runners/run-next.mjs start -- -p 3000",
            "typecheck": "tsc --noEmit",
            "lint": "node scripts/runners/run-eslint.mjs",
            "lint:fix": "node scripts/runners/run-eslint.mjs --fix",
            "format": "prettier --write src/**/*.{ts,tsx}",
            "validate": "npm run typecheck && npm run lint",
            "validate:docs": "npm run -s generate:global-inventory && node scripts/validators/validate-docs.mjs",
            "validate:blog": "node scripts/validators/validate-blog.mjs",
            "validate:case-study-structure": "node scripts/validators/validate-case-study-structure.mjs",
            "validate:case-study-structure:fix": "node scripts/validators/validate-case-study-structure.mjs --fix",
            "validate:case-study-structure:report": "node scripts/validators/validate-case-study-structure.mjs --report-json",
            "validate:service-structure": "node scripts/validators/validate-service-structure.mjs",
            "validate:service-structure:fix": "node scripts/validators/validate-service-structure.mjs --fix",
            "validate:service-structure:report": "node scripts/validators/validate-service-structure.mjs --report-json",
            "validate:feature-structure": "node scripts/validators/validate-feature-structure.mjs",
            "validate:feature-structure:fix": "node scripts/validators/validate-feature-structure.mjs --fix",
            "validate:feature-structure:report": "node scripts/validators/validate-feature-structure.mjs --report-json",
            "validate:home-structure": "node scripts/validators/validate-home-structure.mjs",
            "validate:home-structure:report": "node scripts/validators/validate-home-structure.mjs --report-json",
            "validate:industry-structure": "node scripts/validators/validate-industry-structure.mjs",
            "validate:industry-structure:fix": "node scripts/validators/validate-industry-structure.mjs --fix",
            "validate:industry-structure:report": "node scripts/validators/validate-industry-structure.mjs --report-json",
            "validate:resources": "node scripts/validators/validate-resources.mjs",
            "validate:reports-structure": "node scripts/validators/validate-reports-structure.mjs",
            "graph:validate": "tsx scripts/validators/validate-graph.ts",
            "graph:inspect": "NODE_ENV=development tsx scripts/analyzers/inspect-graph.ts",
            "validate:design": "node scripts/validators/validate-design-system.cjs",
            "analyze:gaps": "tsx scripts/analyzers/generate-content-gaps.ts",
            "analyze:intelligence": "tsx scripts/analyzers/generate-content-intelligence.ts",
            "analyze:score": "node scripts/analyzers/score-content.mjs",
            "analyze:consistency": "node scripts/analyzers/audit-content-consistency.mjs",
            "analyze:priority": "node scripts/analyzers/detect-page-priorities.mjs",
            "analyze:content": "node scripts/analyzers/report-content-readiness.mjs",
            "phase7:visual": "node --import tsx/esm scripts/phase7/run-visual-audit.js",
            "analyze:report": "node --import tsx/esm scripts/analyzers/export-reports.mjs --type=client",
            "analyze:readable-report": "node --import tsx/esm scripts/analyzers/export-reports.mjs --type=readable",
            "analyze": "npm run generate:core && node --import tsx/esm scripts/analyzers/export-reports.mjs",
            "validate:all": "node scripts/core/validate-all.mjs",
            "test": "vitest",
            "test:smoke": "playwright test tests/smoke",
            "test:seo": "playwright test tests/seo",
            "test:interactions": "playwright test tests/interactions",
            "test:visual": "playwright test tests/visual",
            "test:ui": "playwright test --ui",
            "test:report": "playwright show-report",
            "validate:ci": "npm run -s validate:all && npm run -s build && npm run -s test:smoke",
            "images:test": "tsx scripts/generators/image-generate.ts --mode test",
            "images:blog": "tsx scripts/generators/image-generate.ts --domain blog",
            "images:resources": "tsx scripts/generators/image-generate.ts --domain resources",
            "images:industries": "tsx scripts/generators/image-generate.ts --domain industries",
            "images:case-studies": "tsx scripts/generators/image-generate.ts --domain case-studies",
            "image:generate": "tsx scripts/generators/image-generate.ts",
            "images:queue:start": "tsx scripts/generators/image-generate.ts --queue start",
            "images:queue:status": "tsx scripts/generators/image-generate.ts --queue status",
            "images:queue:resume": "tsx scripts/generators/image-generate.ts --queue resume",
            "images:inspect": "tsx scripts/analyzers/image-inspect.ts",
            "images:diagram": "tsx scripts/generators/image-generate.ts --diagram"
      }
}
