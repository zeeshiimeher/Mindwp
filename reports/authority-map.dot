    style=dashed;
    color="#CBD5E1";
    "legend_orphan" [label="Orphan", fillcolor="#DC2626", fontcolor="white", shape=box];
    "legend_weak"   [label="Weak",   fillcolor="#EAB308",   fontcolor="black", shape=box];
    "legend_strong" [label="Strong",  fillcolor="#16A34A",  fontcolor="white", shape=box];
  }

