digraph AuthorityMap {
  rankdir=LR;
  node [style=filled, fontname="Helvetica", fontsize=10];
  edge [fontsize=8, color="#94A3B8"];

  subgraph cluster_legend_types {
    label="Content Types";
    style=dashed;
    color="#CBD5E1";
    "legend_blog" [label="blog", fillcolor="#3B82F6", fontcolor="white", shape=note];
    "legend_resource" [label="resource", fillcolor="#8B5CF6", fontcolor="white", shape=folder];
